<launch>
  <!-- use "device:baudrate" for apm, "device" for asctec -->
  <arg name="comm_port"                 default="/dev/ttyS0:921600"/>
  <arg name="system_ID" default="" />
  <arg name="tgt_system" default="" />
  <arg name="path_to_state_mtx" default="" />

    <include file="$(find pre_hrl)/../mavros/mavros/launch/apm.launch">
      <arg name="fcu_url" value="$(arg comm_port)"/>
      <arg name="tgt_system" value="$(arg tgt_system)" />  

  </include>

    <group ns="custom_params">
        <rosparam file="$(find pre_hrl)/../config/custom_param.yaml" />
        <rosparam file="/home/config/id_file.yaml" />
<!--	<rosparam file="/home/config/custom_param.yaml" /> -->
    </group>




    <arg name="bag_name" default="latest"/>

   <node pkg="rosbag" name="record" type="record" args="-a -o /home/rosbags/" />

   <node name="pre_hrl_node" pkg="pre_hrl" type="pre_hrl_node" output="screen" />

   <node name="hrl_lqi_node" pkg="hrl_lqi" type="hrl_lqi_node" output="screen" /> 

   <node name="post_hrl_node" pkg="post_hrl" type="post_hrl_node" output="screen" /> 


</launch>
