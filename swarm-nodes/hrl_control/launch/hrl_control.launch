<launch>

  <!-- Set default values from environment variables -->
  <param name="MavPort"  value="$(optenv PORT udp://127.0.0.1:14560@14565)" />
  <param name="SystemID" value="$(optenv SYS_ID 1)" />
  <param name="agentIDX"  value="$(optenv AGENT_IDX 1)" />
  <param name="agentAlt"  value="$(optenv AGENT_ALT 400)" />
  <param name="homeLat"   value="$(optenv HOME_LAT 40.846740)"/>
  <param name="homeLon"   value="$(optenv HOME_LON -96.471819)"/>
  <param name="homeAlt"   value="$(optenv HOME_ALT 390)"/>

  <!-- <group ns="agent_$(arg system_ID)">
    <node pkg="hrl_control" name="hrl_control" type="hrl_control" output="screen" args="$(arg system_ID) $(arg agentIDX) $(arg agentAlt) $(arg homeLat) $(arg homeLon) $(arg homeAlt)">
      <remap from="/mavros/debug_value/debug_vector" to="/agent_$(arg system_ID)/mavros/debug_value/debug_vector"/>
      <remap from="/mavros/global_position/swarm" to="/agent_$(arg system_ID)/mavros/global_position/swarm"/>
      <remap from="/mavros/debug_value/send" to="/agent_$(arg system_ID)/mavros/debug_value/send"/>
      <remap from="/mavros/setpoint_position/global" to="/agent_$(arg system_ID)/mavros/setpoint_position/global"/>
      <remap from="/mavros/set_mode" to="/agent_$(arg system_ID)/mavros/set_mode"/>
      <remap from="/agent_position_xy" to="/agent_$(arg system_ID)/agent_position_xy"/>
      <remap from="/agent_pos" to="/agent_$(arg system_ID)/agent_pos"/>
      <remap from="/state_debug" to="/agent_$(arg system_ID)/state_debug"/>
    </node> -->

  <arg name="fcu_url" default="$(env PORT)"/>
  <arg name="gcs_url" default="" />
  <arg name="tgt_system" default="$(env SYS_ID)" />
  <arg name="tgt_component" default="" />
  <arg name="log_output" default="screen" />
  <arg name="fcu_protocol" default="v2.0" />
  <arg name="respawn_mavros" default="false" />

  <include file="$(find mavros)/launch/node.launch">
    <arg name="pluginlists_yaml" value="$(find mavros)/launch/apm_pluginlists.yaml" />
    <arg name="config_yaml" value="$(find mavros)/launch/apm_config.yaml" />
    <arg name="fcu_url" value="$(arg fcu_url)" />
    <arg name="gcs_url" value="$(arg gcs_url)" />
    <arg name="tgt_system" value="$(arg tgt_system)" />
    <arg name="tgt_component" value="$(arg tgt_component)" />
    <arg name="log_output" value="$(arg log_output)" />
    <arg name="fcu_protocol" value="$(arg fcu_protocol)" />
    <arg name="respawn_mavros" value="$(arg respawn_mavros)" />
  </include>
  

  <!-- Launch state_provider node -->
  <node name="state_provider" pkg="state_provider" type="state_provider" output="screen" />

  <!-- Launch controller node -->
  <node name="hrl_control" pkg="hrl_control" type="hrl_control" output="screen" />

  <!-- Launch command_xform node -->
  <node name="command_xform" pkg="command_xform" type="command_xform" output="screen">

    <!-- Remap the command topic to the swarm_comms topic -->
    <!-- <remap from="/agent_1/mavros/setpoint_raw/attitude" to="debug" /> -->
  </node>

  <node name="hrl_command_interpret" pkg="hrl_command_interpret" type="hrl_command_interpret" output="screen" />
</launch>