
/* This implements preparation of the complete state space for the HRL-LQI controller.
*/

#include <ros/ros.h>
#include <thread>
#include <string>
#include <mutex>
#include "std_msgs/String.h"
#include <math.h>
#include <fstream>
#include <eigen3/Eigen/Dense>
#include <custom_libs/geo_converter.hpp>
#include <custom_libs/json_reader.hpp>
#include <swarm_msgs/GlobalStates.h>
#include <swarm_msgs/gps.h>
#include <mavros_msgs/DebugValue.h>
#include <chrono>
#include <time.h>

#define ROS_NODE_NAME "pre_hrl"
#define CONTROLLER_RATE 1    // Rate in Hz 

float state[12] = {0.0} ; // stores all the states
std::mutex state_mutex ; // mutex for state variable

int groups[1] = {2};

float base_lat = 40.8328500 ;
float base_lon = -96.6959400 ;

std::string topic_to_hrl = "/swarm/global_states" ;

int get_state_idx(int id){
        // This function returns the array index of the states w.r.t the agent group
        int n_dim = 2 ;
	int n_states = 2 ;

	// Index of the state array where an agent should start writing its states
	int idx = 0 ;

	// size of the groups array
	int n_groups = sizeof(groups)/sizeof(groups[0]);

	int ag_group = 0 ; // This calculates to which does an agent belong to
        for(int i=0 ; i<n_groups ; i++){

		if()


	}



	// A variable to count the accumulated agent count
	int members = 0 ;

	for(int i=0 ; i<n_groups ; i++){

		members = members + groups[i] ;
		int temp = members - groups[i]; //see the previous accumulation value

		// TODO : Make sure the agents are IDs from 1 .. N .. if IDed from 0 ... N, change id-1 to id
		if(id-1 < members){
			// each agent in a group has 6 states. (pos+vel in x,y directions + 2 integral states)
			idx = temp*(n_dim*n_states + n_dim) + (id -1 - temp -1)*(n_dim*n_states);
			break ;
		}
	}
	return idx ;
}

int get_integral_idx(int id){
        // This function returns the array index of the integral states w.r.t the agent group
        int n_dim = 2 ;
        int n_states = 2 ;

        // Index of the state array where an agent should start writing its states
        int idx = 0 ;

        // size of the groups array
        int n_groups = sizeof(groups)/sizeof(groups[0]);

        // A variable to count the accumulated agent count
        int members = 0 ;
        for(int i=0 ; i<n_groups ; i++){

                members = members + groups[i] ;
                int temp = members - groups[i]; //see the previous accumulation value
                if(id < members){
                        // each agent in a group has 6 states. (pos+vel in x,y directions + 2 integral states for x,y)
                        idx = temp*(n_dim*n_states + n_dim) + (id - temp)*(n_dim*n_states) + (id - temp -1)*(n_dim) ;
                        break ;
                }
        }
        return idx ;
}


void gpsCallback(swarm_msgs::gps new_msg){

	// This function reads the callback messgaes, re-arrange them to the specific order of the formation
	int ag_id = new_msg.id ;
	int ag_state_idx = get_state_idx(ag_id);
	int ag_itgrl_idx = get_integral_idx(ag_id);

	ROS_INFO("Incoming gps ID : %d    state idx : %d     intgrl_idx : %d",ag_id,ag_state_idx,ag_itgrl_idx);

	geo_converter gc ;

	float ag_x = gc.lon_to_meters_signed(base_lat,base_lon, base_lat,new_msg.lon) ;// x state with respect to the base (0,0)
	float ag_y = gc.lat_to_meters_signed(base_lat,base_lon, new_msg.lat,base_lon) ;// y state with respect to the base (0,0)
	float ag_vx = new_msg.vx ;
	float ag_vy = new_msg.vy ;


	// Re-arrange stuff
	const std::lock_guard<std::mutex> lock(state_mutex);
	// Copy the value from the estimator to the state variable
	state[ag_state_idx] = ag_x ;
	state[ag_state_idx+1] = ag_y ;
	state[ag_state_idx+2] = ag_vx ;
	state[ag_state_idx+3] = ag_vy ;

	//state[ag_itgrl_idx] = ag_itegral_x_when_implemented ;
}


void integralStateCallback(mavros_msgs::DebugValue debug_msg){
	// This function waits for debug msg with integral value and updates the state array

	// Get the id and the idx from he debus msg
	int id = (int) debug_msg.data[0];
	int idx = get_integral_idx(id);

	float intgrl_vale = debug_msg.data[1] ;

	// Mutex to access the state array and update the cooresponding location 
	const std::lock_guard<std::mutex> lock(state_mutex);
	state[idx] = intgrl_vale ;
}

void statePublisher()
{
	// This function calculates the conbtrol input to the system and propergates the system one time step forward to generate the new way points

	ros::NodeHandle h_sp ; // Handle for state publishing
	ros::Publisher state_publisher = h_sp.advertise<swarm_msgs::GlobalStates> ( topic_to_hrl , 1, true );

	// Create a new msg
	swarm_msgs::GlobalStates msg ;

	// Get the  array size of state ;
	state_mutex.lock();
	int sizeof_state = sizeof(state)/sizeof(state[0]);
	state_mutex.unlock();

	// Create a copy of the state array so that we can release the lock
	float duplicate_state[sizeof_state];

	while (ros::ok()) {

		ros::Rate loop_rate(CONTROLLER_RATE);

		// Access the lock for the states array
		state_mutex.lock();

		// Cpoy to state array to the dublicate array
//		std::copy(std::begin(state), std::end(state), std::begin(duplicate_state));
		std::copy(state, state+sizeof_state, duplicate_state);

		// Release the lock
                state_mutex.unlock();

		for (int i = 0; i <= 12; i++){
			ROS_INFO("Inside the state array elemet %d : %f", i, duplicate_state[i]);
		}

		// TODO : This part needs to be tested for logical correctness.
		// Check if the state array is empty
		float *retur_ptr = std::find(duplicate_state, duplicate_state+sizeof_state,0);
		if(retur_ptr != duplicate_state+sizeof_state){
			ROS_INFO("OMG I am here");
			// There's a zero in the state array, which means it's not fully filled yet
		}else{
			// All states are avaibale. ready to publish
			msg.header.stamp = ros::Time::now();

			for(int i = 0; i < sizeof_state ; i++){
				// Add elememts one by one
				msg.states.push_back(duplicate_state[i]);
			}

			// Publish to the /swarm/global_states topic
			state_publisher.publish(msg);
		}

		ros::spinOnce();
        	loop_rate.sleep();
	}


}

int main( int argc, char** argv )
{
	ros::init(argc, argv, ROS_NODE_NAME); //Initialize the node


	ros::NodeHandle hl;
	ros::Subscriber gps_callback = hl.subscribe("/hrl/gps", 1, gpsCallback);
	ros::Subscriber intgrl_state_callback = hl.subscribe("/mavros/debug_value/send", 1, integralStateCallback);

	// Create seperate threads for processes with specific Hz requirements
	std::thread state_publisher (statePublisher); //Sperate thread for the publisher function

	// join the threads at the end
	state_publisher.join() ;

	return 0;
}
