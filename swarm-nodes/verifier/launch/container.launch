<launch>

	<arg name="system_ID" default="" />
	<arg name="homeLon" default="-96.4710998" />
	<arg name="homeLat" default="40.8459997" />

	<arg name="fcu_url" default=""/>
	<arg name="gcs_url" default="" />
	<arg name="tgt_system" default="" />
	<arg name="tgt_component" default="" />
	<arg name="log_output" default="screen" />
	<arg name="fcu_protocol" default="v2.0" />
	<arg name="respawn_mavros" default="true" />
	<arg name="plotFile" default="agent_$(arg system_ID).json" />
	

	<include file="$(find mavros)/launch/node.launch">
		<arg name="pluginlists_yaml" value="$(find mavros)/launch/apm_pluginlists.yaml" />
		<arg name="config_yaml" value="$(find mavros)/launch/apm_config.yaml" />

		<arg name="fcu_url" value="$(arg fcu_url)" />
		<arg name="gcs_url" value="$(arg gcs_url)" />
		<arg name="tgt_system" value="$(arg system_ID)" />
		<arg name="tgt_component" value="$(arg tgt_component)" />
		<arg name="log_output" value="$(arg log_output)" />
		<arg name="fcu_protocol" value="$(arg fcu_protocol)" />
		<arg name="respawn_mavros" value="$(arg respawn_mavros)" />
	</include>

    <node pkg="pos_xform" name="pos_xform" type="pos_xform" output="screen" args="$(arg system_ID) $(arg homeLat) $(arg homeLon)" >

    </node>

    <node pkg="verifier" name="verifier" type="verifier" output="screen" args="$(arg system_ID) plotting $(arg plotFile)">

    </node>

    <node pkg="swarm_comms" name="swarm_comms" type="swarm_comm.py" output="screen" args="$(arg system_ID)">

    </node>

</launch>
