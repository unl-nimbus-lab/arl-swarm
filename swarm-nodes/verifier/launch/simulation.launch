            <remap from="/agent_position_xy" to="/agent_$(arg system_ID4)/agent_position_xy"/>

        </node>

        <node pkg="verifier" name="verifier" type="verifier" output="screen" args="$(arg system_ID4)">
            <remap from="/agent_position_xy" to="/agent_$(arg system_ID4)/agent_position_xy"/>
            <remap from="/mavros/set_mode" to="/agent_$(arg system_ID4)/mavros/set_mode" />
            <!-- <remap from="/reachable_state" to="/agent_$(arg system_ID4)/reachable_state"/> -->
            <remap from="/my_reach_state"  to="/agent_$(arg system_ID4)/my_reach_state" />
            <remap from="/received_state"  to="/agent_$(arg system_ID4)/received_state" />
        </node>

    </group>

    <node pkg="swarm_comms" name="agent_$(arg system_ID4)_swarm_comms" type="swarm_comm.py" output="screen" args="$(arg system_ID4) sim 8">

    </node>

    <group ns="agent_$(arg system_ID5)">
        <node pkg="pos_xform" name="pos_xform" type="pos_xform" output="screen" args="$(arg system_ID5) $(arg homeLat) $(arg homeLon)"> 

            <remap from="/mavros/global_position/swarm" to="/agent_$(arg system_ID5)/mavros/global_position/swarm"/>
            <remap from="/mavros/global_position/swarm_vel" to="/agent_$(arg system_ID5)/mavros/global_position/swarm_vel"/>
            <remap from="/mavros/local_position/velocity_local" to="/agent_$(arg system_ID5)/mavros/local_position/velocity_local" />
            <remap from="/agent_position_xy" to="/agent_$(arg system_ID5)/agent_position_xy"/>

        </node>

        <node pkg="verifier" name="verifier" type="verifier" output="screen" args="$(arg system_ID5)">
            <remap from="/agent_position_xy" to="/agent_$(arg system_ID5)/agent_position_xy"/>
            <remap from="/mavros/set_mode" to="/agent_$(arg system_ID5)/mavros/set_mode" />
            <!-- <remap from="/reachable_state" to="/agent_$(arg system_ID5)/reachable_state"/> -->
