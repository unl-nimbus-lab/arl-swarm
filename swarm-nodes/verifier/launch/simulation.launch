            <remap from="/mavros/global_position/swarm" to="/agent_$(arg system_ID6)/mavros/global_position/swarm"/>
            <remap from="/mavros/global_position/swarm_vel" to="/agent_$(arg system_ID6)/mavros/global_position/swarm_vel"/>
            <remap from="/mavros/local_position/velocity_local" to="/agent_$(arg system_ID6)/mavros/local_position/velocity_local" />
            <remap from="/agent_position_xy" to="/agent_$(arg system_ID6)/agent_position_xy"/>

