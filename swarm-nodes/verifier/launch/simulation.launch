            <remap from="/mavros/global_position/swarm_vel" to="/agent_$(arg system_ID8)/mavros/global_position/swarm_vel"/>
            <remap from="/mavros/local_position/velocity_local" to="/agent_$(arg system_ID8)/mavros/local_position/velocity_local" />
            <remap from="/agent_position_xy" to="/agent_$(arg system_ID8)/agent_position_xy"/>

        </node>

        <node pkg="verifier" name="verifier" type="verifier" output="screen" args="$(arg system_ID8)">
            <remap from="/agent_position_xy" to="/agent_$(arg system_ID8)/agent_position_xy"/>
            <remap from="/mavros/set_mode" to="/agent_$(arg system_ID8)/mavros/set_mode" />
            <!-- <remap from="/reachable_state" to="/agent_$(arg system_ID8)/reachable_state"/> -->
